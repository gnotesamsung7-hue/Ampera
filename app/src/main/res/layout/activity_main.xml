<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/face_background">

    <!-- The robot face fills the screen -->
    <com.example.eyebot.VectorFaceView
        android:id="@+id/faceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Small picture-in-picture camera preview (double-tap the face to toggle) -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="120dp"
        android:layout_height="90dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="12dp"
        android:contentDescription="@string/preview_desc"
        android:visibility="gone" />

    <!-- Debug readout: current emotion + face offset (visible with the preview) -->
    <TextView
        android:id="@+id/debugText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="12dp"
        android:fontFamily="monospace"
        android:textColor="#803FE0C5"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/permissionText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:padding="12dp"
        android:text="@string/camera_denied"
        android:textColor="#3FE0C5"
        android:visibility="gone" />
</FrameLayout>
